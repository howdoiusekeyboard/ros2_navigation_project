# Navigation decision with explanations
# Generated by xai_navigator_node

std_msgs/Header header

# Decision information
string decision_type             # plan_path, avoid_obstacle, recovery, goal_reached
string explanation_simple        # User-friendly explanation
string explanation_detailed      # Technical details for experts

# Navigation data
geometry_msgs/PoseStamped goal
nav_msgs/Path planned_path
float32 path_length              # Total distance in meters
float32 estimated_time           # ETA in seconds

# Decision confidence
float32 confidence               # How confident is the planner (0-1)
string[] considered_alternatives # Other options considered (for XAI)
