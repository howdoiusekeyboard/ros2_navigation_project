# Anomaly detection alert from digital twin comparison
# Generated by digital_twin_monitor_node

std_msgs/Header header

# Anomaly detection results
float32 anomaly_score            # Isolation Forest score (negative = more anomalous)
bool is_anomaly                  # True if score below threshold
string explanation               # SHAP-based explanation

# Feature importance for explainability
string[] top_features            # Most contributing features
float32[] feature_values         # Their current values
float32[] shap_values            # SHAP importance scores

# Robot state comparison
geometry_msgs/Pose real_pose     # Real robot position
geometry_msgs/Pose twin_pose     # Digital twin position
float32 position_deviation       # Distance between real and twin
float32 orientation_deviation    # Angle difference

# Alert severity
uint8 severity                   # 0=info, 1=warning, 2=critical
string recommended_action        # Suggested response
